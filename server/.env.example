# server/.env.example
# ─────────────────────────────────────────────────────────────────────────────
# Copy this file to server/.env and fill in your values.
# NEVER commit server/.env to Git — it is listed in .gitignore.
# ─────────────────────────────────────────────────────────────────────────────

# Application
NODE_ENV=development
PORT=5000

# MongoDB — use your Atlas connection string or local URI
# Atlas example:  mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/exam_proctoring?retryWrites=true&w=majority
# Local example:  mongodb://127.0.0.1:27017/exam_proctoring
MONGODB_URI=mongodb://127.0.0.1:27017/exam_proctoring

# Frontend origin (no trailing slash)
CLIENT_URL=http://localhost:5173

# JWT secrets — generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
# Use DIFFERENT strings for access and refresh!
JWT_ACCESS_SECRET=replace_with_64_char_random_hex_string_do_not_use_this_value
JWT_REFRESH_SECRET=replace_with_different_64_char_random_hex_string_do_not_use_this_value
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# bcrypt cost factor (12 is a good balance of security and performance)
BCRYPT_ROUNDS=12

# ─── Demo admin seed credentials (development only) ──────────────────────────
# Used by: npm run seed:admin
# Change these before running the seed in any shared environment.
SEED_ADMIN_EMAIL=admin@examportal.dev
SEED_ADMIN_NAME=System Administrator
SEED_ADMIN_PASSWORD=Admin@1234!

# ─── Email (optional — required for email verification) ──────────────────────
# In development, leave blank to use Ethereal (auto-creates a preview URL in console)
# SMTP_HOST=smtp.ethereal.email
# SMTP_PORT=587
# SMTP_USER=your_ethereal_user
# SMTP_PASS=your_ethereal_pass
# EMAIL_FROM=noreply@examportal.dev
